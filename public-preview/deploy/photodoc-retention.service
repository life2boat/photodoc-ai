[Unit]
Description=PhotoDoc AI — удаление исходных файлов заказов старше 72 часов
Documentation=file:/srv/photodoc/RETENTION.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# The first manual run must be a dry run: `--dry-run` prints the plan without touching files.
# The timer itself runs live; enable it only after that review and the owner's approval.
ExecStart=/usr/bin/docker exec photodoc-pr22-private-backend-1 \
    python /app/retention.py --hours 72
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
