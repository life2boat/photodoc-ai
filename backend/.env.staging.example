# PhotoDoc AI - Staging Environment Variables (Template)
# Fully isolated from production secrets and live credentials.

DATABASE_PATH=/data/orders.db
PHOTODOC_REQUIRE_DB_IDENTITY=1

# Disable automated external deliveries by default in staging
DELIVERY_WORKER_ENABLED=0

# Robokassa Test Credentials
ROBOKASSA_IS_TEST=1
ROBOKASSA_MERCHANT_LOGIN=staging_merchant
ROBOKASSA_PASSWORD1=staging_pass1
ROBOKASSA_PASSWORD2=staging_pass2

# Yandex Disk Staging Root (Isolated from PhotoDoc_Orders/)
YANDEX_DISK_ROOT_DIR=PhotoDoc_Staging
YANDEX_DISK_TOKEN=y0_test_staging_token_mock

# Test SMTP Credentials (Local Mailhog / Mailpit / Mock)
SMTP_SERVER=127.0.0.1
SMTP_PORT=2525
SMTP_USER=staging@photodoc-ai.ru
SMTP_PASSWORD=staging_secret
EMAIL_TO=staging_owner@photodoc-ai.ru

# Application Port
PORT=8081
