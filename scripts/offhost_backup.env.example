# PhotoDoc AI — off-host backup configuration template.
#
# Copy to /etc/photodoc/backup.env on the VPS (mode 0600, root-owned) and fill in.
# Nothing in this repository reads this file automatically, and no scheduled job
# is installed by the repository: activation is an explicit owner action.
#
# Until every required value below is present, `scripts/offhost_backup.py` exits 2
# and reports exactly what is missing. That is the intended state.

# --- local backup root (required) --------------------------------------------
BACKUP_ROOT=/var/backups/photodoc

# --- off-host destination (required) -----------------------------------------
# Any scp/rsync/ssh-style target, or a mounted path. Used as {dest} below.
# Examples:
#   OFFHOST_DEST=backup@example.org:/srv/photodoc-offsite
#   OFFHOST_DEST=/mnt/offsite/photodoc
OFFHOST_DEST=

# --- encryption (at least one is required) -----------------------------------
# Preferred: a passphrase file readable only by root. The script refuses a file
# whose mode is not 0600.
#   openssl rand -base64 48 > /etc/photodoc/backup.passphrase
#   chmod 600 /etc/photodoc/backup.passphrase
OFFHOST_PASSFILE=/etc/photodoc/backup.passphrase
# Alternative: public-key encryption to an off-host key you control.
OFFHOST_RECIPIENT=

# --- push command (required) -------------------------------------------------
# Placeholders: {artifact} {checksum} {dest} {name}
# The artifact is already encrypted when this runs; never point it at a path that
# logs arguments verbatim.
OFFHOST_PUSH_CMD=scp -q -o BatchMode=yes {artifact} {checksum} {dest}/

# --- verification (strongly recommended) -------------------------------------
# Placeholders: {name} {dest} {sha256}. Exit non-zero if the remote copy does not
# match. Without this, the run is reported as "pushed but unverified" and is NOT
# operational.
#   OFFHOST_VERIFY_CMD=ssh -o BatchMode=yes backup@example.org "sha256sum -c -"
OFFHOST_VERIFY_CMD=

# --- retention ---------------------------------------------------------------
OFFHOST_KEEP_LAST=14
OFFHOST_KEEP_DAILY=30
OFFHOST_KEEP_WEEKLY=12

# --- local retention ---------------------------------------------------------
# Used by scripts/backup_retention.py via run_backup.sh.
BACKUP_KEEP_LAST=7
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# --- logging -----------------------------------------------------------------
BACKUP_LOG=/var/log/photodoc-backup.log
